<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- API depends on the shared models and business contracts. -->
    <ProjectReference Include="..\Models\IRacingLeague.Models.csproj" />
    <ProjectReference Include="..\Business\IRacingLeague.Business.csproj" />
    <ProjectReference Include="..\Data.EF\IRacingLeague.Data.EF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Required in the startup project for the EF Core design-time tools (migrations). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The apphost pack is unavailable on the locked-down host; run via `dotnet IRacingLeague.API.dll`. -->
    <UseAppHost>false</UseAppHost>
    <UserSecretsId>iracing-league-api-local</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
