# Copy this file to .env and replace every value marked CHANGE_ME.
POSTGRES_DB=IRacingLeague
POSTGRES_USER=iracing
POSTGRES_PASSWORD=CHANGE_ME_database_password
ConnectionStrings__ServerDB=Host=db;Port=5432;Database=IRacingLeague;Username=iracing;Password=CHANGE_ME_database_password
JWT__SecretKey=CHANGE_ME_generate_a_private_random_key_at_least_32_bytes
Demo__Enabled=false
# Optional: trusted reverse proxy IPs, indexed from 0. Forwarded client IPs
# are ignored unless the immediate peer matches one of these addresses.
# ForwardedHeaders__KnownProxies__0=10.0.0.10
